# Local development secrets. Copy this file to `.dev.vars` (that file is git-ignored).
# NEVER commit real values here. For production, use Cloudflare Worker secrets:
#   npx wrangler secret put <NAME>   (see wrangler.toml for the list)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=REPLACE_ME"
ACCESSTOKEN_SECRET="replace-with-a-long-random-string"
REFRESHTOKEN_SECRET="replace-with-a-different-long-random-string"
GEMINI_API_KEY="AIzaSy_REPLACE_WITH_YOUR_GEMINI_KEY"
API_KEY="re_REPLACE_WITH_YOUR_RESEND_KEY"
CLIENT_ID="replace-with-your-google-client-id.apps.googleusercontent.com"
CLIENT_SECRET="GOCSPX-replace-with-your-google-client-secret"
FRONTEND_URL="http://localhost:5173"
