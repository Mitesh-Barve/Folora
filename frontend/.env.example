# Copy to frontend/.env for local dev (that file is git-ignored).
# On Vercel, add these as Project Environment Variables.
VITE_USERS_BACKEND_URL=http://localhost:8787/api/v1/users
VITE_BLOGS_BACKEND_URL=http://localhost:8787/api/v1/blog
VITE_GOOGLE_AUTH_URL=http://localhost:8787/auth/google

# Cloudinary UNSIGNED upload settings. These two values are PUBLIC by design
# (they ship in the browser bundle) - safe to expose. Do NOT put the Cloudinary
# API Secret / API Key here.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_name
